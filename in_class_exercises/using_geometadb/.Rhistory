)
s36 <- summary(fit, times = t_pred)
pred_36m <- data.frame(
group       = gsub(paste0("^", group_var, "="), "", s36$strata),
time_months = s36$time,
surv_36m    = s36$surv,
lower_95    = s36$lower,
upper_95    = s36$upper,
n_risk      = s36$n.risk
)
# print as percentages
pred_36m <- pred_36m %>%
mutate(
surv_36m_pct  = 100 * surv_36m,
lower_95_pct  = 100 * lower_95,
upper_95_pct  = 100 * upper_95
)
print(pred_36m)
# subtype level analysis - idh_mut_codel
# variables to include:
# sex
# age group
# risk
# grade
library(ggplot2)
library(ggpubr)
library(dplyr)
library(survival)
library(survminer)
df <- read.csv('/Users/anzaralvi/Desktop/foundation_model_paper/HR/entire_cohort_metadata.csv')
# filter to idh_wt patients and assign risk group
v0_idh_mut_codel <- df[df$SUBTYPE == "IDHmut-codel", ]
nrow(v0_idh_mut_codel)
g2_idh_mut_codel <- v0_idh_mut_codel[v0_idh_mut_codel$GRADE == "G2", ]
g3_idh_mut_codel <- v0_idh_mut_codel[v0_idh_mut_codel$GRADE == "G3", ]
g2_idh_mut_codel$risk_group <- "IDHmut-codel_G2"
cutoff = 0.83
g3_idh_mut_codel$risk_group <- ifelse(g3_idh_mut_codel$risk_mean >= cutoff,
"IDHmut-codel_G3_B",
"IDHmut-codel_G3_A")
idh_mut_codel <- rbind(g2_idh_mut_codel, g3_idh_mut_codel)
# Plot
# Make sure 'grade' is treated as a factor (categorical)
idh_mut_codel$GRADE <- as.factor(idh_mut_codel$GRADE)
# Define custom colors for each risk group
custom_colors <- c(
"IDHmut-codel_G2" = "#6699CC",  # blue
"IDHmut-codel_G3_B"  = "#FFDD57",  # green
"IDHmut-codel_G3_A" = "#FF6F61"   # red
)
# Barplot with proportions and custom colors
ggplot(idh_mut_codel, aes(x = GRADE, fill = risk_group)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent_format()) +
scale_fill_manual(values = custom_colors) +  # apply custom colors here
labs(
# title = "Distribution of Risk Group by Tumor Grade",
x = "Tumor Grade",
y = "Proportion",
fill = "Risk Group"
) +
theme_minimal() +
theme(
panel.grid.major = element_blank(),     # remove major gridlines
panel.grid.minor = element_blank(),     # remove minor gridlines
)
ggplot(idh_mut_codel, aes(x = GRADE, y = risk_mean, fill = GRADE)) +
geom_boxplot(outlier.shape = NA, alpha = 0.8) +
geom_jitter(width = 0.2, alpha = 0.4, size = 1.5) +
scale_fill_manual(values = c("G2" = "#6699CC", "G3" = "#FF6F61")) +
geom_hline(yintercept = 0.5, linetype = "dashed", color = "black") +
labs(
x = "Tumor Grade",
y = "Risk Score"
) +
theme_minimal() +
theme(
legend.position = "none",
panel.grid.major = element_blank(),     # remove major gridlines
panel.grid.minor = element_blank(),     # remove minor gridlines
panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8),  # add border
axis.line = element_line(color = "black")  # keep axis lines visible
)
####################
idh_mut_codel <- idh_mut_codel %>%
mutate(AGE_GROUP = case_when(
AGE >= 17 & AGE <= 54 ~ "Group 1 (17-54)",
AGE >= 55 & AGE <= 75 ~ "Group 2 (55-75)",
TRUE ~ NA_character_  # catches any ages outside your specified ranges
))
# idh_mut_codel <- idh_mut_codel[idh_mut_codel$MIB != "Unknown", ]
idh_mut_codel$GRADE <- relevel(factor(idh_mut_codel$GRADE), ref = "G2")
idh_mut_codel$SEX <- relevel(factor(idh_mut_codel$SEX), ref = "Female")
idh_mut_codel$AGE_GROUP <- relevel(factor(idh_mut_codel$AGE_GROUP), ref = "Group 1 (17-54)")
idh_mut_codel$risk_group <- relevel(factor(idh_mut_codel$risk_group), ref = "IDHmut-codel_G2")
idh_mut_codel$risk_group <- factor(idh_mut_codel$risk_group, levels = c("IDHmut-codel_G2", "IDHmut-codel_G3_A", "IDHmut-codel_G3_B"))
# idh_mut_codel$risk_group <- relevel(factor(idh_mut_codel$risk_group), ref = "IDHmut-codel_G3_A")
# idh_mut_codel$risk_group <- factor(idh_mut_codel$risk_group, levels = c("IDHmut-codel_G3_A", "IDHmut-codel_G3_B"))
# Univariate HR Analysis
table(idh_mut_codel$risk_group)
univariate_model <- coxph(Surv(Time, Survival) ~ risk_group,
data = idh_mut_codel)
summary(univariate_model)
# generate the kaplan-meier curve
fit <- survfit(Surv(Time, Survival) ~ risk_group, data = idh_mut_codel)
# print median survival data
medians <- surv_median(fit)
print(medians)
# Mean and standard error for each AGE_GROUP
idh_mut_codel %>%
group_by(risk_group) %>%
summarise(
mean_surv = mean(Time, na.rm = TRUE),
se_surv = sd(Time, na.rm = TRUE) / sqrt(n())
)
# 36 month predicted survival
group_var <- "GRADE"   # change this to any feature you want
t_pred <- 36
fit <- survfit(
as.formula(paste0("Surv(Time, Survival) ~ ", group_var)),
data = idh_mut_codel
)
s36 <- summary(fit, times = t_pred)
pred_36m <- data.frame(
group       = gsub(paste0("^", group_var, "="), "", s36$strata),
time_months = s36$time,
surv_36m    = s36$surv,
lower_95    = s36$lower,
upper_95    = s36$upper,
n_risk      = s36$n.risk
)
# print as percentages
pred_36m <- pred_36m %>%
mutate(
surv_36m_pct  = 100 * surv_36m,
lower_95_pct  = 100 * lower_95,
upper_95_pct  = 100 * upper_95
)
print(pred_36m)
