table(idh_mut_non_codel$risk_group)
univariate_model <- coxph(Surv(Time, Survival) ~ risk_group,
data = idh_mut_non_codel)
summary(univariate_model)
# generate the kaplan-meier curve
fit <- survfit(Surv(Time, Survival) ~ risk_group, data = idh_mut_non_codel)
# print median survival data
medians <- surv_median(fit)
print(medians)
# Mean and standard error
idh_mut_non_codel %>%
group_by(risk_group) %>%
summarise(
mean_surv = mean(Time, na.rm = TRUE),
se_surv = sd(Time, na.rm = TRUE) / sqrt(n())
)
# 36 month predicted survival
group_var <- "risk_group"   # change this to any feature you want
t_pred <- 36
fit <- survfit(
as.formula(paste0("Surv(Time, Survival) ~ ", group_var)),
data = idh_mut_non_codel
)
s36 <- summary(fit, times = t_pred)
pred_36m <- data.frame(
group       = gsub(paste0("^", group_var, "="), "", s36$strata),
time_months = s36$time,
surv_36m    = s36$surv,
lower_95    = s36$lower,
upper_95    = s36$upper,
n_risk      = s36$n.risk
)
# print as percentages
pred_36m <- pred_36m %>%
mutate(
surv_36m_pct  = 100 * surv_36m,
lower_95_pct  = 100 * lower_95,
upper_95_pct  = 100 * upper_95
)
print(pred_36m)
